# Firebase Configuration
# Скопіюйте цей файл як .env та додайте свої дані з Firebase Console

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Custom API / MariaDB connection (optional)
VITE_DATA_API_BASE_URL=https://your-api-host.example.com
VITE_AUTH_API_BASE_URL=https://your-api-host.example.com
VITE_RUNTIME_SETTINGS_API_BASE_URL=https://your-api-host.example.com
VITE_DATA_API_TOKEN=your_api_token_here

MIGRATION_DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=lucia
# For PostgreSQL use this and set MIGRATION_DB_ENGINE=postgres
# POSTGRES_URL=postgres://user:password@host:5432/database

# Comma-separated emails that should always have admin role at platform level
VITE_PLATFORM_ADMIN_EMAILS=andrii.disha@gmail.com
