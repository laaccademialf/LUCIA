# LUCIA custom-db migration server — приклад env-файлу
# Скопіювати на сервері у /etc/lucia/db.env та заповнити реальними значеннями.
# НЕ комітити заповнений файл у git. chmod 600.

# --- Рушій БД -------------------------------------------------------------
# КРИТИЧНО: завжди тримай це = mysql на проді.
# Якщо env не підхопиться і сервер не зможе підключитись до MariaDB,
# він НЕ стартує (а не тихо віддасть порожні дані з file-режиму).
MIGRATION_DB_ENGINE=mysql
MIGRATION_DB_REQUIRE_ENGINE=mysql

# --- Підключення до MariaDB ----------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=app_user
MYSQL_PASSWORD=ЗАМІНИ_НА_РЕАЛЬНИЙ_ПАРОЛЬ
MYSQL_DATABASE=app_db

# --- Безпека API ----------------------------------------------------------
# Той самий токен, що використовує фронт (Authorization: Bearer <token>).
CUSTOM_MIGRATION_TOKEN=ЗАМІНИ_НА_ДОВГИЙ_ВИПАДКОВИЙ_РЯДОК

# --- Мережа ---------------------------------------------------------------
MIGRATION_PORT=8787
MIGRATION_HOST=127.0.0.1

# --- CORS (опційно) --------------------------------------------------------
# Порожньо (рекомендовано) = авторежим: дозволено same-host origin (той самий
# домен, що й API — домен можна міняти без правок) + dev origins (localhost,
# Codespaces). Задай список лише якщо фронт живе на ІНШОМУ домені, ніж API:
# RUNTIME_SETTINGS_CORS_ORIGIN=https://app.example.com,https://staging.example.com

# --- Кореневий каталог застосунку (доменонезалежний) -----------------------
# Задай ОДИН раз — усі шляхи (img, haccp, legal) підуть від нього:
LUCIA_APP_ROOT=/var/www/example.com/app
# Або перевизнач шляхи напряму (мають пріоритет над LUCIA_APP_ROOT):
# ASSET_IMAGE_DIR=/var/www/example.com/app/img
ASSET_IMAGE_PUBLIC_BASE=/app/img

# --- Vik-Soft (облік електроенергії) -------------------------------------
# Креди зазвичай задаються через UI «Управління утилітами» і зберігаються у
# runtime-settings.json. Env — фолбек / для headless-серверів.
# VIKSOFT_API_BASE=http://194.183.165.59:8765
# VIKSOFT_USER=la_familia
# VIKSOFT_PASSWORD=ЗАМІНИ
# Стійкість до «часті помилки з конектом»: ретраї транзитних мережевих збоїв.
# VIKSOFT_NETWORK_RETRIES=2
# VIKSOFT_RETRY_BASE_DELAY_MS=600
# VIKSOFT_REQUEST_TIMEOUT_MS=20000

# Щоденний автоімпорт показників по ВСІХ ресторанах о 03:00 за київським часом.
# Увімкнено типово; вимкнути: LUCIA_VIKSOFT_DAILY_SYNC_ENABLED=false
LUCIA_VIKSOFT_DAILY_SYNC_ENABLED=true
LUCIA_VIKSOFT_DAILY_SYNC_HOUR=3
LUCIA_VIKSOFT_DAILY_SYNC_MINUTE=0
# Опційний інтервальний імпорт (незалежний від щоденного). Типово вимкнено.
# LUCIA_VIKSOFT_AUTO_SYNC_ENABLED=false
# LUCIA_VIKSOFT_AUTO_SYNC_INTERVAL_MINUTES=30
# LUCIA_VIKSOFT_AUTO_SYNC_FORCE=false
