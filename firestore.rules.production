rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Функція перевірки автентифікації
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Функція перевірки ролі адміністратора
    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'Admin', 'ADMIN'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.workRole in ['admin', 'Admin', 'ADMIN', 'адмін', 'Адмін']
      );
    }

    function isProcurement() {
      return isAuthenticated() && (
        isAdmin() ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['procurement', 'Procurement', 'purchasing', 'Purchasing', 'закупівлі', 'Закупівлі'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.workRole in ['procurement', 'Procurement', 'purchasing', 'Purchasing', 'закупівлі', 'Закупівлі', 'закупки', 'відділ закупівель', 'Відділ закупівель']
        )
      );
    }

    function isMaintenance() {
      return isAuthenticated() && (
        isAdmin() ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['maintenance', 'Maintenance', 'service', 'Service', 'exploitation', 'Exploitation', 'експлуатація', 'Експлуатація'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.workRole in ['maintenance', 'Maintenance', 'service', 'Service', 'exploitation', 'Exploitation', 'експлуатація', 'Експлуатація', 'інженер', 'Інженер', 'відділ експлуатації', 'Відділ експлуатації']
        )
      );
    }
    
    // Правила для користувачів
    match /users/{userId} {
      // Читати можуть всі автентифіковані користувачі
      allow read: if isAuthenticated();
      
      // Створювати/оновлювати може тільки сам користувач або адмін
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Видаляти може тільки адмін
      allow delete: if isAdmin();
    }
    
    // Правила для ресторанів
    match /restaurants/{restaurantId} {
      // Читати можуть всі автентифіковані
      allow read: if isAuthenticated();
      
      // Писати можуть тільки адміністратори
      allow write: if isAdmin();
    }
    
    // Правила для активів (основних засобів)
    match /assets/{assetId} {
      // Читати можуть всі автентифіковані
      allow read: if isAuthenticated();
      
      // Писати можуть всі автентифіковані (можна змінити на тільки адмінів)
      allow write: if isAuthenticated();
    }

    // Довідник продуктів для модуля замовлень
    match /bookingProducts/{productId} {
      // Читати можуть всі автентифіковані користувачі
      allow read: if isAuthenticated();

      // Створення/оновлення/видалення — адміністратор або закупівлі
      allow write: if isProcurement();
    }

    // Довідник постачальників
    match /bookingSuppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if isProcurement();
    }

    // Типові поля замовлень (категорії, одиниці вимірювання)
    match /bookingTypicalFields/{fieldId} {
      allow read: if isAuthenticated();
      allow write: if isProcurement();
    }

    // Журнал відправок консолідованих заявок постачальникам
    match /supplierDispatches/{dispatchId} {
      allow read: if isAuthenticated();
      allow write: if isProcurement();
    }

    // Сервісні заявки (міні CRM для експлуатації)
    match /serviceRequests/{requestId} {
      allow read: if isAuthenticated();

      // Будь-який авторизований користувач може створити заявку від свого імені
      allow create: if isAuthenticated() && request.resource.data.createdById == request.auth.uid;

      // Оновлювати можуть відділ експлуатації/адмін або автор власної заявки
      allow update: if isMaintenance() || request.auth.uid == resource.data.createdById;

      // Видалення тільки для відділу експлуатації/адміна
      allow delete: if isMaintenance();
    }

    // Заявки на продукцію від ресторанів
    match /productOrders/{orderId} {
      // Читати можуть всі автентифіковані користувачі
      allow read: if isAuthenticated();

      // Створювати може автентифікований користувач від свого імені (або адмін)
      allow create: if isAuthenticated() &&
        (isProcurement() || request.resource.data.createdById == request.auth.uid);

      // Оновлення/видалення — адміністратор або закупівлі
      allow update, delete: if isProcurement();
    }
  }
}
